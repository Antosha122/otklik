# TLS-терминация перед приложением.
# PUBLIC_SITE обслуживает порт 8080 (заявители), STAFF_SITE — 8081 (сотрудники).
# Для доменных имён Caddy автоматически получает сертификаты Let's Encrypt;
# для голых IP использует собственный CA (самоподписанный сертификат —
# браузер покажет предупреждение, для демо-стенда это ожидаемо).
{
	# Браузеры не отправляют SNI для голых IP — без подсказки Caddy не может
	# выбрать сертификат и роняет TLS-хендшейк («не удаётся открыть страницу»).
	default_sni {$PUBLIC_SITE}
}

{$PUBLIC_SITE} {
	encode zstd gzip
	reverse_proxy app:8080
}

{$STAFF_SITE} {
	encode zstd gzip
	reverse_proxy app:8081
}

