root = true

# Все текстовые файлы репозитория — UTF-8. Кириллица в комментариях и строках
# обязана одинаково читаться в любом редакторе и в проде (без «кракозябр»).
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[*.{js,mjs,html,css,json,webmanifest,sql,yml,yaml,md}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
