# Скопируйте в .env и заполните: cp .env.example .env
# .env исключён из git (см. .gitignore) — пароли не попадают в репозиторий.

# Пароль PostgreSQL (контейнер db и строка подключения приложения).
POSTGRES_PASSWORD=default_password

# Пароль демо-пользователей, создаваемых при первом старте (admin, operator, ...).
# При первом входе каждый из них обязан сменить пароль — API закрыт до смены.
SEED_DEFAULT_PWD=otklik-demo-2026

# Адреса сайтов для Caddy (TLS-терминация):
#   PUBLIC_SITE -> порт 8080 (заявители), STAFF_SITE -> 8081 (сотрудники).
# Домен — сертификат Let's Encrypt автоматически; голый IP — самоподписанный
# сертификат Caddy (браузер покажет предупреждение). Примеры:
# PUBLIC_SITE=otklik.example.com
# STAFF_SITE=staff.otklik.example.com
# Локальная разработка (значения по умолчанию):
# PUBLIC_SITE=localhost
# STAFF_SITE=localhost:8443

# 1 — куки только по HTTPS (прод за Caddy); 0 — локальная разработка по http.
COOKIE_SECURE=0
