# Скопируйте в .env и заполните: cp .env.example .env
# .env исключён из git (см. .gitignore) — пароли не попадают в репозиторий.

# Пароль PostgreSQL (контейнер db и строка подключения приложения).
POSTGRES_PASSWORD=default_password

# Пароль демо-пользователей, создаваемых при первом старте (admin, operator, ...).
# При первом входе каждый из них обязан сменить пароль — API закрыт до смены.
# Явного дефолта в коде нет: если оставить пустым, приложение сгенерирует
# случайный пароль и напечатает его в лог один раз (при первом старте).
SEED_DEFAULT_PWD=

# Ключ шифрования ночных бэкапов БД (AES-256-CBC, сервис db-backup).
# Обязательно задайте длинную случайную строку. ВАЖНО: при утере ключа
# зашифрованные бэкапы восстановить невозможно — храните копию надёжно.
BACKUP_KEY=change_me_long_random_string

# Адреса сайтов для Caddy (TLS-терминация):
#   PUBLIC_SITE -> порт 8080 (заявители), STAFF_SITE -> 8081 (сотрудники).
# Домен — сертификат Let's Encrypt автоматически; голый IP — самоподписанный
# сертификат Caddy (браузер покажет предупреждение). Примеры:
# PUBLIC_SITE=otklik.example.com
# STAFF_SITE=staff.otklik.example.com
# Локальная разработка (значения по умолчанию):
# PUBLIC_SITE=localhost
# STAFF_SITE=localhost:8443

# 1 — куки только по HTTPS (обязательно на проде, за Caddy);
# 0 — только для локальной разработки по http. НЕ забывайте включать на проде:
# при 0 куки сессий уходят и по HTTP и могут быть перехвачены.
COOKIE_SECURE=0

# Срок хранения завершённых обращений в днях (RETENTION_DAYS, по умолчанию 730);
# 0 — хранить бессрочно. Формат логов приложения: json (прод) или text.
# RETENTION_DAYS=730
# LOG_FORMAT=json

# Сколько nightly-бэкапов БД хранить (сервис db-backup, по умолчанию 14).
# BACKUP_KEEP=14
